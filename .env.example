# Environment overrides recognised by crypto_simulator/config/settings.py.
# All variables are optional; unset values fall back to config/default.yaml.
# They are read from the process environment only: the simulator does not
# load a .env file itself. To use a copy, export it into your shell first,
# e.g. `set -a; source .env; set +a`.

# CRYPTOSIM_DB_PATH=data/simulator.db
# CRYPTOSIM_STARTING_BALANCE=100000.0
# CRYPTOSIM_LOG_LEVEL=INFO
# CRYPTOSIM_RANDOM_SEED=42
# CRYPTOSIM_PRICING_MODE=random_walk
